{
	"compilerOptions": {
		"target": "ES2020",
		"module": "Node16",
		"lib": ["ES2020"],
		"outDir": "./dist",
		"rootDir": "./src",
		"types": ["node", "discord.js"],

		"strict": true,
		"esModuleInterop": true,

		"noUnusedParameters": true,
		"noUnusedLocals": true,
		"skipLibCheck": true,

		// We're unfortunately stuck with the experimental version due to typeorm
		// https://github.com/typeorm/typeorm/issues/9862
		"experimentalDecorators": true
	}
}
